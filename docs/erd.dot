digraph ERD {
  rankdir=LR; splines=true; nodesep=0.45; ranksep=1.1; bgcolor="white";
  node [shape=plain, fontname="Helvetica"]; edge [fontname="Helvetica", fontsize=9, color="#52514e"];
  labelloc=t; fontname="Helvetica-Bold"; fontsize=16; label="Olist E-Commerce Database: Entity Relationship Diagram (SQLite)";
  customers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>customers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="customer_unique_id">customer_unique_id</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="zip_code_prefix">zip_code_prefix</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="city">city</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="state">state</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  sellers [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>sellers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="seller_id">seller_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="zip_code_prefix">zip_code_prefix</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="city">city</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="state">state</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  geolocation [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>geolocation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="zip_code_prefix">zip_code_prefix</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="latitude">latitude</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="longitude">longitude</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="city">city</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="state">state</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  product_categories [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>product_categories</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="category_name">category_name</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="category_name_en">category_name_en</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  products [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>products</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="product_id">product_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3dc" PORT="category_name">category_name</TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="name_length">name_length</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="description_length">description_length</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="photos_qty">photos_qty</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="weight_g">weight_g</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="length_cm">length_cm</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="height_cm">height_cm</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="width_cm">width_cm</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  orders [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="order_id">order_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3dc" PORT="customer_id">customer_id</TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="order_status">order_status</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="purchase_ts">purchase_ts</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="approved_ts">approved_ts</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="delivered_carrier_ts">delivered_carrier_ts</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="delivered_customer_ts">delivered_customer_ts</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="estimated_delivery_date">estimated_delivery_date</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="purchase_year">purchase_year</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="purchase_month">purchase_month</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="delivery_days">delivery_days</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="delay_days">delay_days</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="is_late">is_late</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  order_items [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>order_items</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="order_id">order_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK, FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="order_item_id">order_item_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3dc" PORT="product_id">product_id</TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fdf3dc" PORT="seller_id">seller_id</TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fdf3dc"><B>FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="shipping_limit_ts">shipping_limit_ts</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="price">price</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="freight_value">freight_value</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="total_price">total_price</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  order_payments [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>order_payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="order_id">order_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK, FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="payment_sequential">payment_sequential</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="payment_type">payment_type</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="payment_installments">payment_installments</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="payment_value">payment_value</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">REAL</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  order_reviews [label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD COLSPAN="3" BGCOLOR="#2a78d6"><FONT COLOR="white"><B>order_reviews</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="review_id">review_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#e8f1fc" PORT="order_id">order_id</TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#e8f1fc"><B>PK, FK</B></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="review_score">review_score</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">INTEGER</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="comment_title">comment_title</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="comment_message">comment_message</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="creation_date">creation_date</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="white" PORT="answer_ts">answer_ts</TD><TD ALIGN="LEFT" BGCOLOR="white"><FONT COLOR="#52514e">TEXT</FONT></TD><TD ALIGN="LEFT" BGCOLOR="white">&nbsp;</TD></TR></TABLE>>];
  orders:customer_id -> customers:customer_id [dir=both, arrowtail=crow, arrowhead=tee, label=" customer_id"];
  order_items:order_id -> orders:order_id [dir=both, arrowtail=crow, arrowhead=tee, label=" order_id"];
  order_items:product_id -> products:product_id [dir=both, arrowtail=crow, arrowhead=tee, label=" product_id"];
  order_items:seller_id -> sellers:seller_id [dir=both, arrowtail=crow, arrowhead=tee, label=" seller_id"];
  order_payments:order_id -> orders:order_id [dir=both, arrowtail=crow, arrowhead=tee, label=" order_id"];
  order_reviews:order_id -> orders:order_id [dir=both, arrowtail=crow, arrowhead=tee, label=" order_id"];
  products:category_name -> product_categories:category_name [dir=both, arrowtail=crow, arrowhead=tee, label=" category_name"];
  customers -> geolocation [style=dashed, color="#9a998f", arrowhead=none, label=" zip_code_prefix (lookup, no FK)"];
  sellers -> geolocation [style=dashed, color="#9a998f", arrowhead=none];
  legend [shape=plain, label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" COLOR="#c9c8c2"><TR><TD BGCOLOR="#e8f1fc">PK = primary key</TD></TR><TR><TD BGCOLOR="#fdf3dc">FK = foreign key</TD></TR><TR><TD>crow foot = "many" side</TD></TR></TABLE>>];
}